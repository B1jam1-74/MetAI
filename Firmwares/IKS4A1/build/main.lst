 351:Core/Src/main.c ****           }
 352:Core/Src/main.c ****           metai_decode_output(metai_out, &ai_class, &ai_confidence);
 353:Core/Src/main.c ****           printf("AI Prediction: %u (%s), confidence=%u%%\r\n",
 354:Core/Src/main.c ****                  ai_class,
 355:Core/Src/main.c ****                  METAI_CLASS_NAMES[ai_class],
 356:Core/Src/main.c ****                  ai_confidence);
 357:Core/Src/main.c **** 
 358:Core/Src/main.c ****           // Send the sensor readings and AI prediction over LoRa
 359:Core/Src/main.c ****           lora_envoi_data(temperature, pressure, humidity, ai_class, ai_confidence);
 360:Core/Src/main.c ****           HAL_Delay(1000); // Wait for 1 second to ensure the data is sent before sleeping the LoRa
 361:Core/Src/main.c ****         }
 362:Core/Src/main.c ****         else
 363:Core/Src/main.c ****         {
 364:Core/Src/main.c ****           printf("AI inference failed\r\n");
