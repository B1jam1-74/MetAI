 299:Core/Src/main.c ****     {
 300:Core/Src/main.c ****       // Switch on the LED to indicate that we are about to read the sensors
 301:Core/Src/main.c ****       BSP_LED_On(LED_GREEN);
 302:Core/Src/main.c **** 
