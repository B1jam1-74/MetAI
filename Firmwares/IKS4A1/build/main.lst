 135:Core/Src/main.c **** 
 136:Core/Src/main.c ****   // Configure the LoRa module
 137:Core/Src/main.c ****   printf("Lora module configuration\r\n");
 138:Core/Src/main.c ****   config_Lora();
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****   // Print the list of I2C devices found on the I2C1 bus (IKS4A1) 
 141:Core/Src/main.c ****   printf("Scanning I2C1 bus for devices...\r\n");
 142:Core/Src/main.c ****   uint8_t i2c1_buffer[1];
 143:Core/Src/main.c ****   for (uint16_t i = 1; i < 128; i++)
 144:Core/Src/main.c ****   {
ARM GAS  /tmp/ccfzByrN.s 			page 4


 145:Core/Src/main.c ****     if (HAL_I2C_Master_Receive(&hi2c1, (i << 1), i2c1_buffer, 1, 100) == HAL_OK)
 146:Core/Src/main.c ****     {
 147:Core/Src/main.c ****       printf("Device found at address 0x%02X\r\n", i);
 148:Core/Src/main.c ****     }
 149:Core/Src/main.c ****   }
 150:Core/Src/main.c **** 
 151:Core/Src/main.c ****   // Initialize the STTS22H temperature sensor
 152:Core/Src/main.c ****   STTS22H_Object_t stts22h_obj = {0};
 153:Core/Src/main.c ****   Temperature_Init(&stts22h_obj);
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****   // Initialize the LPS22DF pressure sensor
 156:Core/Src/main.c ****   lps22df_data_t lps22df_data = {0};
 157:Core/Src/main.c ****   Pressure_Init();
 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****   // Initialize the SHT40 temperature and humidity sensor
 160:Core/Src/main.c ****   sht40x_data_t sht40x_data = {0};
 161:Core/Src/main.c ****   if (sht40x_basic_initialize(SHT40_AD1B_VARIANT) != 0)
 162:Core/Src/main.c ****   {
 163:Core/Src/main.c ****     printf("Failed to initialize SHT40 sensor\r\n");
 164:Core/Src/main.c ****   }
 165:Core/Src/main.c ****   else
 166:Core/Src/main.c ****   {
 167:Core/Src/main.c ****     printf("SHT40 sensor initialized successfully\r\n");
 168:Core/Src/main.c ****   }
 169:Core/Src/main.c **** 
 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****   while (1)
 172:Core/Src/main.c ****   {
 173:Core/Src/main.c ****     // Switch on the LED to indicate that we are about to read the sensors
 174:Core/Src/main.c ****     BSP_LED_On(LED_GREEN);
 175:Core/Src/main.c **** 
 176:Core/Src/main.c ****     // Reveille le lora
 177:Core/Src/main.c ****     lora_WakeUp();
 178:Core/Src/main.c ****     HAL_Delay(100); // Wait for the LoRa module to wake up before sending AT commands
 179:Core/Src/main.c **** 
 180:Core/Src/main.c ****     // Read temperature from the STTS22H sensor and print it
 181:Core/Src/main.c ****     float temperature;
 182:Core/Src/main.c ****     Temperature_Read(&stts22h_obj, &temperature);
 183:Core/Src/main.c **** 
 184:Core/Src/main.c ****     // Read pressure and temperature from the LPS22DF sensor and store them
 185:Core/Src/main.c ****     float pressure, temperature_lps22df;
 186:Core/Src/main.c ****     Pressure_Read(lps22df_data, &pressure, &temperature_lps22df);
 187:Core/Src/main.c **** 
 188:Core/Src/main.c ****     // Read temperature and humidity from the SHT40 sensor and print them
 189:Core/Src/main.c ****     float temperature_sht40x, humidity;
 190:Core/Src/main.c ****     Humidity_Temperature_Read(&sht40x_data, &temperature_sht40x, &humidity);
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****     // Print the sensor readings
 193:Core/Src/main.c ****     printf("############################################################\r \n");
 194:Core/Src/main.c ****     printf("STTS22H Temperature: %.2f C\r \n", temperature);
 195:Core/Src/main.c ****     printf("LPS22DF Pressure: %.2f hPa\r \n", pressure);
 196:Core/Src/main.c ****     printf("SHT40 Humidity: %.2f %%\r \n", humidity);
 197:Core/Src/main.c ****     printf("############################################################\r \n");
 198:Core/Src/main.c ****     printf("\r \n");
 199:Core/Src/main.c **** 
 200:Core/Src/main.c ****     uint8_t ai_class = 0, ai_confidence = 0;
 201:Core/Src/main.c **** 
ARM GAS  /tmp/ccfzByrN.s 			page 5


 202:Core/Src/main.c ****     /* USER CODE END WHILE */  
 203:Core/Src/main.c ****     MX_X_CUBE_AI_Process(pressure, temperature, humidity, &ai_class, &ai_confidence);
 204:Core/Src/main.c ****     
 205:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 206:Core/Src/main.c **** 
 207:Core/Src/main.c ****     // Send the sensor readings and AI prediction over LoRa
 208:Core/Src/main.c ****     lora_envoi_data(temperature, pressure, humidity, ai_class, ai_confidence); 
 209:Core/Src/main.c **** 
 210:Core/Src/main.c ****     HAL_Delay(1000); // Wait for 1 second to ensure the data is sent before sleeping the LoRa modul
 211:Core/Src/main.c **** 
 212:Core/Src/main.c ****     // Met le lora en sleep
 213:Core/Src/main.c ****     lora_Sleep();
 214:Core/Src/main.c **** 
 215:Core/Src/main.c ****     // Switch off the LED to indicate that we have finished reading the sensors
 216:Core/Src/main.c ****     BSP_LED_Off(LED_GREEN);
 217:Core/Src/main.c **** 
 218:Core/Src/main.c ****     HAL_Delay(20000); // Wait for 20 seconds before the next reading
 219:Core/Src/main.c ****   }
 220:Core/Src/main.c ****   /* USER CODE END 3 */
 221:Core/Src/main.c **** }
