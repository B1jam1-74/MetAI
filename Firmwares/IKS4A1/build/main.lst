 370:Core/Src/main.c ****       }
 371:Core/Src/main.c **** 
 372:Core/Src/main.c ****       // Met le lora en sleep
 373:Core/Src/main.c ****       lora_Sleep();
 374:Core/Src/main.c **** 
 375:Core/Src/main.c ****       // Switch off the LED to indicate that we have finished reading the sensors
 376:Core/Src/main.c ****       BSP_LED_Off(LED_GREEN);
 377:Core/Src/main.c ****     }
 378:Core/Src/main.c **** 
