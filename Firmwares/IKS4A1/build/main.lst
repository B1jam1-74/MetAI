 321:Core/Src/main.c ****       printf("STTS22H Temperature: %.2f C\r \n", temperature);
 322:Core/Src/main.c ****       printf("LPS22DF Pressure: %.2f hPa\r \n", pressure);
 323:Core/Src/main.c ****       printf("SHT40 Humidity: %.2f %%\r \n", humidity);
 324:Core/Src/main.c ****       printf("############################################################\r \n");
 325:Core/Src/main.c ****       printf("\r \n");
 326:Core/Src/main.c **** 
 327:Core/Src/main.c ****       metai_push_sample(temperature, pressure, humidity, now_ms);
 328:Core/Src/main.c ****       metai_sampling_started = 1U;
 329:Core/Src/main.c ****       metai_next_sample_tick = now_ms + METAI_SAMPLE_INTERVAL_MS; // 2 min pour test
 330:Core/Src/main.c **** 
 331:Core/Src/main.c ****       if (metai_hist_count >= 3U)
 332:Core/Src/main.c ****       {
 333:Core/Src/main.c ****         uint8_t ai_class = 0, ai_confidence = 0;
 334:Core/Src/main.c ****         float metai_raw[METAI_NUM_FEATURES] = {0.0f};
 335:Core/Src/main.c ****         int8_t metai_qin[METAI_NUM_FEATURES] = {0};
 336:Core/Src/main.c ****         int8_t metai_out[METAI_NUM_CLASSES] = {0};
 337:Core/Src/main.c **** 
 338:Core/Src/main.c ****         metai_build_raw_features(metai_raw);
 339:Core/Src/main.c ****         metai_normalize_and_quantize(metai_raw, metai_qin);
 340:Core/Src/main.c **** 
 341:Core/Src/main.c ****         for (uint32_t i = 0; i < METAI_NUM_FEATURES; i++)
 342:Core/Src/main.c ****         {
 343:Core/Src/main.c ****           data_ins[0][i] = metai_qin[i];
 344:Core/Src/main.c ****         }
 345:Core/Src/main.c **** 
 346:Core/Src/main.c ****         if (MX_X_CUBE_AI_Run() != 0)
 347:Core/Src/main.c ****         {
