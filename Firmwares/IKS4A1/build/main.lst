 314:Core/Src/main.c **** 
 315:Core/Src/main.c ****       // Read temperature and humidity from the SHT40 sensor and print them
 316:Core/Src/main.c ****       float temperature_sht40x, humidity;
 317:Core/Src/main.c ****       Humidity_Temperature_Read(&sht40x_data, &temperature_sht40x, &humidity);
 318:Core/Src/main.c **** 
 319:Core/Src/main.c ****       // Print the sensor readings
