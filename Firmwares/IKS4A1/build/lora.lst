 132:Drivers/Sensors/Lora/lora.c **** static uint16_t s_last_uplink_response_len  = 0;
 133:Drivers/Sensors/Lora/lora.c **** 
 134:Drivers/Sensors/Lora/lora.c **** // Envoie les données avec le lora 
 135:Drivers/Sensors/Lora/lora.c **** void lora_envoi_data(float temperature, float pressure, float humidity)
 136:Drivers/Sensors/Lora/lora.c **** {
 137:Drivers/Sensors/Lora/lora.c ****     char lora_cmd[40];
 138:Drivers/Sensors/Lora/lora.c **** 
 139:Drivers/Sensors/Lora/lora.c ****     int8_t  temp_raw     = (int8_t)temperature;
 140:Drivers/Sensors/Lora/lora.c ****     int16_t pressure_raw = (int16_t)(pressure * 10.0f);
 141:Drivers/Sensors/Lora/lora.c ****     uint8_t humidity_raw = (uint8_t)humidity;
 142:Drivers/Sensors/Lora/lora.c **** 
 143:Drivers/Sensors/Lora/lora.c ****     snprintf(lora_cmd, sizeof(lora_cmd), "AT+MSGHEX=%02X%04X%02X\r\n",
 144:Drivers/Sensors/Lora/lora.c ****              (unsigned int)(uint8_t)temp_raw,
 145:Drivers/Sensors/Lora/lora.c ****              (unsigned int)(uint16_t)pressure_raw,
 146:Drivers/Sensors/Lora/lora.c ****              (unsigned int)humidity_raw);
 147:Drivers/Sensors/Lora/lora.c **** 
 148:Drivers/Sensors/Lora/lora.c ****     /* Lire jusqu'à "Done" — s'arrête dès que la réponse est complète */
 149:Drivers/Sensors/Lora/lora.c ****     s_last_uplink_response_len = send_at_command_until(
 150:Drivers/Sensors/Lora/lora.c ****         lora_cmd,
 151:Drivers/Sensors/Lora/lora.c ****         s_last_uplink_response,
 152:Drivers/Sensors/Lora/lora.c ****         sizeof(s_last_uplink_response),
 153:Drivers/Sensors/Lora/lora.c ****         "+MSGHEX: Done",   /* marqueur de fin */
 154:Drivers/Sensors/Lora/lora.c ****         8000               /* timeout de sécurité */
 155:Drivers/Sensors/Lora/lora.c ****     );
 156:Drivers/Sensors/Lora/lora.c **** }
