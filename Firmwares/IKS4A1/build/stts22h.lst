 287:Drivers/Sensors/STTS22H/stts22h.c **** /**
 288:Drivers/Sensors/STTS22H/stts22h.c ****   * @brief  Get the STTS22H temperature sensor output data rate
 289:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  pObj the device pObj
 290:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  Odr pointer where the output data rate is written
 291:Drivers/Sensors/STTS22H/stts22h.c ****   * @retval 0 in case of success, an error code otherwise
 292:Drivers/Sensors/STTS22H/stts22h.c ****   */
 293:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_TEMP_GetOutputDataRate(STTS22H_Object_t *pObj, float *Odr)
 294:Drivers/Sensors/STTS22H/stts22h.c **** {
 295:Drivers/Sensors/STTS22H/stts22h.c ****   int32_t ret = STTS22H_OK;
 296:Drivers/Sensors/STTS22H/stts22h.c ****   stts22h_odr_temp_t odr_low_level;
 297:Drivers/Sensors/STTS22H/stts22h.c **** 
 298:Drivers/Sensors/STTS22H/stts22h.c ****   if (stts22h_temp_data_rate_get(&(pObj->Ctx), &odr_low_level) != STTS22H_OK)
 299:Drivers/Sensors/STTS22H/stts22h.c ****   {
 300:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_ERROR;
 301:Drivers/Sensors/STTS22H/stts22h.c ****   }
 302:Drivers/Sensors/STTS22H/stts22h.c **** 
 303:Drivers/Sensors/STTS22H/stts22h.c ****   switch (odr_low_level)
 304:Drivers/Sensors/STTS22H/stts22h.c ****   {
 305:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_POWER_DOWN:
 306:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_ONE_SHOT:
 307:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 0.0f;
 308:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 309:Drivers/Sensors/STTS22H/stts22h.c **** 
 310:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_1Hz:
 311:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 1.0f;
 312:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 313:Drivers/Sensors/STTS22H/stts22h.c **** 
 314:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_25Hz:
ARM GAS  /tmp/ccBqBt3d.s 			page 8


 315:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 25.0f;
 316:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 317:Drivers/Sensors/STTS22H/stts22h.c **** 
 318:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_50Hz:
 319:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 50.0f;
 320:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 321:Drivers/Sensors/STTS22H/stts22h.c **** 
 322:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_100Hz:
 323:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 100.0f;
 324:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 325:Drivers/Sensors/STTS22H/stts22h.c **** 
 326:Drivers/Sensors/STTS22H/stts22h.c ****     case STTS22H_200Hz:
 327:Drivers/Sensors/STTS22H/stts22h.c ****       *Odr = 200.0f;
 328:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 329:Drivers/Sensors/STTS22H/stts22h.c **** 
 330:Drivers/Sensors/STTS22H/stts22h.c ****     default:
 331:Drivers/Sensors/STTS22H/stts22h.c ****       ret = STTS22H_ERROR;
 332:Drivers/Sensors/STTS22H/stts22h.c ****       break;
 333:Drivers/Sensors/STTS22H/stts22h.c ****   }
 334:Drivers/Sensors/STTS22H/stts22h.c **** 
 335:Drivers/Sensors/STTS22H/stts22h.c ****   return ret;
 336:Drivers/Sensors/STTS22H/stts22h.c **** }
