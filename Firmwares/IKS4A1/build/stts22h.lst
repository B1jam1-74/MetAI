 338:Drivers/Sensors/STTS22H/stts22h.c **** /**
 339:Drivers/Sensors/STTS22H/stts22h.c ****   * @brief  Set the STTS22H temperature sensor output data rate
 340:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  pObj the device pObj
 341:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  Odr the output data rate value to be set
 342:Drivers/Sensors/STTS22H/stts22h.c ****   * @retval 0 in case of success, an error code otherwise
 343:Drivers/Sensors/STTS22H/stts22h.c ****   */
 344:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_TEMP_SetOutputDataRate(STTS22H_Object_t *pObj, float Odr)
 345:Drivers/Sensors/STTS22H/stts22h.c **** {
 346:Drivers/Sensors/STTS22H/stts22h.c ****   stts22h_odr_temp_t new_odr;
 347:Drivers/Sensors/STTS22H/stts22h.c **** 
 348:Drivers/Sensors/STTS22H/stts22h.c ****   new_odr = (Odr <= 1.0f) ? STTS22H_1Hz
 349:Drivers/Sensors/STTS22H/stts22h.c ****             : (Odr <= 25.0f) ? STTS22H_25Hz
 350:Drivers/Sensors/STTS22H/stts22h.c ****             : (Odr <= 50.0f) ? STTS22H_50Hz
 351:Drivers/Sensors/STTS22H/stts22h.c ****             : (Odr <= 100.0f) ? STTS22H_100Hz
 352:Drivers/Sensors/STTS22H/stts22h.c ****             :                    STTS22H_200Hz;
 353:Drivers/Sensors/STTS22H/stts22h.c **** 
 354:Drivers/Sensors/STTS22H/stts22h.c ****   if (stts22h_temp_data_rate_set(&(pObj->Ctx), new_odr) != STTS22H_OK)
 355:Drivers/Sensors/STTS22H/stts22h.c ****   {
 356:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_ERROR;
 357:Drivers/Sensors/STTS22H/stts22h.c ****   }
 358:Drivers/Sensors/STTS22H/stts22h.c **** 
 359:Drivers/Sensors/STTS22H/stts22h.c ****   return STTS22H_OK;
 360:Drivers/Sensors/STTS22H/stts22h.c **** }
