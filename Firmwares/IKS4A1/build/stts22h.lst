 115:Drivers/Sensors/STTS22H/stts22h.c **** /**
 116:Drivers/Sensors/STTS22H/stts22h.c ****   * @brief  Initialize the STTS22H sensor
 117:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  pObj the device pObj
 118:Drivers/Sensors/STTS22H/stts22h.c ****   * @retval 0 in case of success, an error code otherwise
 119:Drivers/Sensors/STTS22H/stts22h.c ****   */
 120:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_Init(STTS22H_Object_t *pObj)
 121:Drivers/Sensors/STTS22H/stts22h.c **** {
 122:Drivers/Sensors/STTS22H/stts22h.c ****   if (pObj->is_initialized == 0U)
 123:Drivers/Sensors/STTS22H/stts22h.c ****   {
 124:Drivers/Sensors/STTS22H/stts22h.c ****     /* Set default ODR */
 125:Drivers/Sensors/STTS22H/stts22h.c ****     pObj->temp_odr = 1.0f;
 126:Drivers/Sensors/STTS22H/stts22h.c **** 
 127:Drivers/Sensors/STTS22H/stts22h.c ****     /* Enable BDU */
 128:Drivers/Sensors/STTS22H/stts22h.c ****     if (stts22h_block_data_update_set(&(pObj->Ctx), PROPERTY_ENABLE) != STTS22H_OK)
 129:Drivers/Sensors/STTS22H/stts22h.c ****     {
 130:Drivers/Sensors/STTS22H/stts22h.c ****       return STTS22H_ERROR;
 131:Drivers/Sensors/STTS22H/stts22h.c ****     }
 132:Drivers/Sensors/STTS22H/stts22h.c **** 
 133:Drivers/Sensors/STTS22H/stts22h.c ****     /* Enable Automatic Address Increment */
 134:Drivers/Sensors/STTS22H/stts22h.c ****     if (stts22h_auto_increment_set(&(pObj->Ctx), PROPERTY_ENABLE) != STTS22H_OK)
 135:Drivers/Sensors/STTS22H/stts22h.c ****     {
 136:Drivers/Sensors/STTS22H/stts22h.c ****       return STTS22H_ERROR;
 137:Drivers/Sensors/STTS22H/stts22h.c ****     }
 138:Drivers/Sensors/STTS22H/stts22h.c **** 
 139:Drivers/Sensors/STTS22H/stts22h.c ****     /* Put the component in standby mode. */
 140:Drivers/Sensors/STTS22H/stts22h.c ****     if (stts22h_temp_data_rate_set(&(pObj->Ctx), STTS22H_POWER_DOWN) != STTS22H_OK)
 141:Drivers/Sensors/STTS22H/stts22h.c ****     {
 142:Drivers/Sensors/STTS22H/stts22h.c ****       return STTS22H_ERROR;
ARM GAS  /tmp/ccBqBt3d.s 			page 4


 143:Drivers/Sensors/STTS22H/stts22h.c ****     }
 144:Drivers/Sensors/STTS22H/stts22h.c ****   }
 145:Drivers/Sensors/STTS22H/stts22h.c **** 
 146:Drivers/Sensors/STTS22H/stts22h.c ****   pObj->is_initialized = 1;
 147:Drivers/Sensors/STTS22H/stts22h.c **** 
 148:Drivers/Sensors/STTS22H/stts22h.c ****   return STTS22H_OK;
 149:Drivers/Sensors/STTS22H/stts22h.c **** }
 150:Drivers/Sensors/STTS22H/stts22h.c **** 
 151:Drivers/Sensors/STTS22H/stts22h.c **** /**
 152:Drivers/Sensors/STTS22H/stts22h.c ****   * @brief  Deinitialize the STTS22H sensor
 153:Drivers/Sensors/STTS22H/stts22h.c ****   * @param  pObj the device pObj
 154:Drivers/Sensors/STTS22H/stts22h.c ****   * @retval 0 in case of success, an error code otherwise
 155:Drivers/Sensors/STTS22H/stts22h.c ****   */
 156:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_DeInit(STTS22H_Object_t *pObj)
 157:Drivers/Sensors/STTS22H/stts22h.c **** {
 158:Drivers/Sensors/STTS22H/stts22h.c ****   if (pObj->is_initialized == 1U)
 159:Drivers/Sensors/STTS22H/stts22h.c ****   {
 160:Drivers/Sensors/STTS22H/stts22h.c ****     /* Put the component in standby mode */
 161:Drivers/Sensors/STTS22H/stts22h.c ****     if (STTS22H_TEMP_Disable(pObj) != STTS22H_OK)
 162:Drivers/Sensors/STTS22H/stts22h.c ****     {
 163:Drivers/Sensors/STTS22H/stts22h.c ****       return STTS22H_ERROR;
 164:Drivers/Sensors/STTS22H/stts22h.c ****     }
 165:Drivers/Sensors/STTS22H/stts22h.c ****   }
 166:Drivers/Sensors/STTS22H/stts22h.c **** 
 167:Drivers/Sensors/STTS22H/stts22h.c ****   pObj->is_initialized = 0;
 168:Drivers/Sensors/STTS22H/stts22h.c **** 
 169:Drivers/Sensors/STTS22H/stts22h.c ****   return STTS22H_OK;
 170:Drivers/Sensors/STTS22H/stts22h.c **** }
