 242:Drivers/Sensors/STTS22H/stts22h.c ****   {
 243:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_OK;
 244:Drivers/Sensors/STTS22H/stts22h.c ****   }
 245:Drivers/Sensors/STTS22H/stts22h.c **** 
 246:Drivers/Sensors/STTS22H/stts22h.c ****   /* Power on the component and set the odr. */
 247:Drivers/Sensors/STTS22H/stts22h.c ****   if (STTS22H_TEMP_SetOutputDataRate(pObj, pObj->temp_odr) != STTS22H_OK)
 248:Drivers/Sensors/STTS22H/stts22h.c ****   {
 249:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_ERROR;
