 262:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_TEMP_Disable(STTS22H_Object_t *pObj)
 263:Drivers/Sensors/STTS22H/stts22h.c **** {
 264:Drivers/Sensors/STTS22H/stts22h.c ****   /* Check if the component is already disabled */
 265:Drivers/Sensors/STTS22H/stts22h.c ****   if (pObj->temp_is_enabled == 0U)
 266:Drivers/Sensors/STTS22H/stts22h.c ****   {
 267:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_OK;
 268:Drivers/Sensors/STTS22H/stts22h.c ****   }
 269:Drivers/Sensors/STTS22H/stts22h.c **** 
 270:Drivers/Sensors/STTS22H/stts22h.c ****   /* Save the current odr. */
 271:Drivers/Sensors/STTS22H/stts22h.c ****   if (STTS22H_TEMP_GetOutputDataRate(pObj, &pObj->temp_odr) != STTS22H_OK)
 272:Drivers/Sensors/STTS22H/stts22h.c ****   {
 273:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_ERROR;
 274:Drivers/Sensors/STTS22H/stts22h.c ****   }
 275:Drivers/Sensors/STTS22H/stts22h.c **** 
 276:Drivers/Sensors/STTS22H/stts22h.c ****   /* Put the component in standby mode. */
 277:Drivers/Sensors/STTS22H/stts22h.c ****   if (stts22h_temp_data_rate_set(&(pObj->Ctx), STTS22H_POWER_DOWN) != STTS22H_OK)
 278:Drivers/Sensors/STTS22H/stts22h.c ****   {
 279:Drivers/Sensors/STTS22H/stts22h.c ****     return STTS22H_ERROR;
 280:Drivers/Sensors/STTS22H/stts22h.c ****   }
 281:Drivers/Sensors/STTS22H/stts22h.c **** 
 282:Drivers/Sensors/STTS22H/stts22h.c ****   pObj->temp_is_enabled = 0;
 283:Drivers/Sensors/STTS22H/stts22h.c **** 
 284:Drivers/Sensors/STTS22H/stts22h.c ****   return STTS22H_OK;
 285:Drivers/Sensors/STTS22H/stts22h.c **** }
