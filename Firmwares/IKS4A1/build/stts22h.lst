 238:Drivers/Sensors/STTS22H/stts22h.c **** int32_t STTS22H_TEMP_Enable(STTS22H_Object_t *pObj)
 239:Drivers/Sensors/STTS22H/stts22h.c **** {
 240:Drivers/Sensors/STTS22H/stts22h.c ****   /* Check if the component is already enabled */
