            ]
        ]
    },
    {
        "id": "575262fa624d9c43",
        "type": "function",
        "z": "0739ecf24a48a045",
        "name": "Send downlink",
        "func": "// Parse the string from InfluxDB\nconst rows = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\nif (!rows || rows.length < 2) {\n    node.warn(\"Not enough rows: \" + (rows ? rows.length : 0));\n    return null;\n}\n\nconst r3 = rows[0];\nconst r6 = rows[rows.length - 1];\n\n//node.warn(\"r3: \" + JSON.stringify(r3));\n//node.warn(\"r6: \" + JSON.stringify(r6));\n\nmsg.url = \"https://eu1.cloud.thethings.network/api/v3/as/applications/benjamin-lora-app/devices/lora-e5/down/push\";\nmsg.method = \"POST\";\nmsg.headers = {\n    \"Authorization\": \"Bearer NNSXS.ASS55SSF55M4AI6EO36ZJJSYRY7SNSRK3O6DO7Y.PE36VE4NBL5H37A5HALATJUPT3FC4BOPEGZ72IJRDWQZGQYXXFLQ\",\n    \"Content-Type\": \"application/json\"\n};\nmsg.payload = JSON.stringify({\n    downlinks: [{\n        decoded_payload: {\n            temp_3h: r3[\"temperature_C\"],\n            hum_3h:  r3[\"humidity_pct\"],\n            pres_3h: r3[\"pressure_hPa\"],\n            temp_6h: r6[\"temperature_C\"],\n            hum_6h:  r6[\"humidity_pct\"],\n            pres_6h: r6[\"pressure_hPa\"]\n        },\n        f_port: 11,\n        priority: \"NORMAL\"\n    }]\n});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
