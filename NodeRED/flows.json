        "type": "function",
        "z": "0739ecf24a48a045",
        "name": "Parse prediction",
        "func": "const payload = msg.payload.uplink_message.decoded_payload;\nconst deviceId = msg.payload.end_device_ids.device_id;\nconst receivedAt = msg.payload.received_at;\n\nmsg.url    = \"http://192.168.0.79:8000/prediction\";\nmsg.method = \"POST\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = {\n    device_id:         \"metai\",\n    received_at:       receivedAt,\n    confidence_pct:    payload.confidence_pct,\n    predicted_class:   payload.weather_class,\n    prediction_fr:     payload.weather_label\n};\n\nreturn msg;",
