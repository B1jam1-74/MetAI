    {
        "id": "e2b4b8eafabfb324",
        "type": "function",
        "z": "0739ecf24a48a045",
        "name": "Query database",
        "func": "const now = Date.now();\n\nconst t3h_start = new Date(now - 3 * 3600 * 1000 - 5 * 60 * 1000).toISOString();\nconst t3h_end   = new Date(now - 3 * 3600 * 1000 + 5 * 60 * 1000).toISOString();\nconst t6h_start = new Date(now - 6 * 3600 * 1000 - 5 * 60 * 1000).toISOString();\nconst t6h_end   = new Date(now - 6 * 3600 * 1000 + 5 * 60 * 1000).toISOString();\n\nconst q = `SELECT \n  \"temperature_C\", \n  \"humidity_pct\", \n  \"pressure_hPa\", \n  time \nFROM weather_sensor\nWHERE (time >= '${t3h_start}' AND time <= '${t3h_end}')\n   OR (time >= '${t6h_start}' AND time <= '${t6h_end}')\nORDER BY time ASC`;\n\nmsg.url = \"http://192.168.0.79:8181/api/v3/query_sql\"\n        + \"?db=metai\"\n        + \"&q=\" + encodeURIComponent(q);\nmsg.method = \"GET\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 280,
