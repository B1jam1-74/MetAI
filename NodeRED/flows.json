    {
        "id": "f5475c5453432fb6",
        "type": "function",
        "z": "0739ecf24a48a045",
        "name": "Parse sensors",
        "func": "const payload = msg.payload.uplink_message.decoded_payload;\nconst deviceId = msg.payload.end_device_ids.device_id;\nconst receivedAt = msg.payload.received_at;\n\nmsg.url    = \"http://192.168.0.79:8000/uplink\";\nmsg.method = \"POST\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = {\n    device_id:         \"metai\",\n    received_at:       receivedAt,\n    temperature_deg_c: payload.temperature_C,\n    humidity_percent:  payload.humidity_pct,\n    pressure_hpa:      payload.pressure_hPa,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
